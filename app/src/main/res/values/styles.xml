<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="BottomNavStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@null</item>
    </style>
    <style name="Theme.NotaSawit" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorContainer">@android:color/transparent</item>

    </style>
    <style name="App.CustomIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/agri_green_dark</item>
        <item name="android:width">80dp</item>
        <item name="android:height">35dp</item> <item name="marginHorizontal">10dp</item>
    </style>
    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>
    <style name="CustomActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/agri_green_dark</item>

        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LabelStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#999999</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ValueStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>


</resources>
