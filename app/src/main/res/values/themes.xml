<resources xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base application theme. -->
    <style name="Base.Theme.Notasawit" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Disable Material 3 surface tint overlays globally -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">@color/white</item>
        <!-- Fix TextInputLayout stroke colors globally -->
        <item name="colorControlNormal">@color/tertiary</item>
        <item name="colorControlActivated">@color/primary</item>
    </style>

    <style name="Theme.Notasawit" parent="Base.Theme.Notasawit" />
</resources>