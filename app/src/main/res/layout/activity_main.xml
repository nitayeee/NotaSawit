<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <!-- White Background (SplashScreen 3 & 4) -->
    <View
        android:id="@+id/view_white_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF" />

    <!-- Dark Green Background (SplashScreen 1 & 2) -->
    <View
        android:id="@+id/view_green_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1B4D2E" />

    <!-- Centered Content Wrapper -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_center_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo & Brand Name Horizontal Container -->
        <LinearLayout
            android:id="@+id/ll_logo_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Frame Layout for overlapping White & Colored logo icons -->
            <FrameLayout
                android:id="@+id/fl_logo_wrapper"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginStart="-12dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- White Logo Icon (SplashScreen 2) -->
                <ImageView
                    android:id="@+id/iv_logo_white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:contentDescription="White Logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_splash_screen" />

                <!-- Colored Logo Icon (SplashScreen 3 & 4) -->
                <ImageView
                    android:id="@+id/iv_logo_colored"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:contentDescription="Colored Logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo" />

            </FrameLayout>

            <!-- Brand Name Text (SplashScreen 4) -->
            <TextView
                android:id="@+id/tv_brand_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="8dp"
                android:alpha="0"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="SILAUSA"
                android:textColor="#002617"
                android:textSize="38sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Subtitle / Tagline (SplashScreen 4) -->
        <TextView
            android:id="@+id/tv_tagline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="8dp"
            android:alpha="0"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="sistem informasi lahan, audit, dan keuangan sawit"
            android:textColor="#556B5C"
            android:textSize="13.5sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/ll_logo_container"
            app:layout_constraintStart_toStartOf="@id/ll_logo_container"
            app:layout_constraintTop_toBottomOf="@id/ll_logo_container" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>