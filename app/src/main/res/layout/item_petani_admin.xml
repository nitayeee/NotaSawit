<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Avatar Circle -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvInitial"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:background="@drawable/bg_circle_avatar_initial"
                android:text="P" />

            <ImageView
                android:id="@+id/ivProfil"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Foto Petani" />
        </FrameLayout>

        <!-- Petani Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNamaPetani"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Petani"
                android:textColor="#0D2617"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\@username"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Badges: Desa & Status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <!-- Desa Badge -->
                <TextView
                    android:id="@+id/tvDesaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desa Kiab Jaya"
                    android:textColor="#166534"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_medium"
                    android:background="@drawable/bg_badge_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Aktif"
                    android:textColor="#334155"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/poppins_medium"
                    android:background="@drawable/rounded_bg_gray"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Right Chevron Indicator -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="#94A3B8"
            android:contentDescription="Detail" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

