<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- TOP BAR DENGAN SOFT SHADOW -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:backgroundTint="@color/white"
        android:elevation="3dp"
        app:elevation="3dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:backgroundTint="@color/white"
            app:contentInsetStart="0dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:orientation="horizontal">

                <!-- Logo Box -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:strokeColor="@android:color/transparent"
                    app:cardBackgroundColor="#F4F7F4">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/logo"
                        android:contentDescription="Logo" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Greeting -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selamat datang 👋"
                        android:textColor="#64748B"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/poppins_medium" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Halo, "
                            android:textColor="#0D2617"
                            android:textSize="16.5sp"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:id="@+id/username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Petani!"
                            android:textColor="#1B4D2E"
                            android:textSize="16.5sp"
                            android:fontFamily="@font/poppins_bold" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Avatar -->
                <FrameLayout
                    android:id="@+id/btnProfileContainer"
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <TextView
                        android:id="@+id/tvInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_avatar_circle"/>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="1dp"
                        android:scaleType="centerCrop"
                        app:strokeWidth="2dp"
                        app:strokeColor="#1B4D2E"
                        app:shapeAppearanceOverlay="@style/CircleImage"/>

                </FrameLayout>

            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Dummy view for scroll compatibility -->
        <View
            android:id="@+id/view_header_shadow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_scrollFlags="scroll|enterAlways|snap" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- SWIPE REFRESH LAYOUT -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- SCROLL CONTENT -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:padding="16dp"
            android:paddingBottom="80dp">

            <!-- ALERT TAHUN TANAM KOSONG -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAlertTahunTanam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFF3E0"
                app:strokeWidth="0dp"
                app:strokeColor="@android:color/transparent"
                app:useCompatPadding="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_dialog_alert"
                            app:tint="#E65100" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Tahun tanam lahan Anda masih kosong. Silakan lengkapi data lahan agar fitur aplikasi dapat berjalan maksimal."
                            android:textColor="#E65100"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIsiTahunTanam"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="#E65100"
                        android:fontFamily="@font/poppins_bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="16dp"
                        android:text="Isi Sekarang"
                        android:textColor="@android:color/white"
                        android:textSize="11.5sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BANNER PANEN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:useCompatPadding="true"
                app:strokeWidth="0dp"
                app:strokeColor="@android:color/transparent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_bulanan"
                        android:scaleType="centerCrop"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mei 2026"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12.5sp"
                            android:fontFamily="@font/poppins_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Total Panen Bulan Ini"
                            android:textColor="#E0FFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/tv_total_panen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="12.4 Ton"
                            android:textColor="@color/white"
                            android:textSize="32sp"
                            android:fontFamily="@font/poppins_bold"
                            android:letterSpacing="-0.02" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="↑ +8% dari bulan lalu"
                            android:textColor="#D1FAE5"
                            android:textSize="11.5sp"
                            android:fontFamily="@font/poppins_medium" />

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- PEMASUKAN & PENGELUARAN SUMMARY CARDS DENGAN SOFT SHADOW TANPA CLIPPING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:weightSum="2">

                <!-- Pemasukan Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:useCompatPadding="true"
                    app:strokeWidth="0dp"
                    app:strokeColor="@android:color/transparent"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!-- Green left accent border -->
                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="#1B4D2E" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↓ PEMASUKAN"
                                android:textColor="#64748B"
                                android:textSize="10.5sp"
                                android:fontFamily="@font/poppins_bold"
                                android:letterSpacing="0.04" />

                            <TextView
                                android:id="@+id/tv_pemasukan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Rp 45.0M"
                                android:textColor="#1B4D2E"
                                android:textSize="16sp"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:id="@+id/tv_badge_pemasukan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="↑ Bulan ini"
                                android:textColor="#1B4D2E"
                                android:textSize="10sp"
                                android:fontFamily="@font/poppins_medium"
                                android:background="@drawable/bg_badge_green"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp" />

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pengeluaran Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:useCompatPadding="true"
                    app:strokeWidth="0dp"
                    app:strokeColor="@android:color/transparent"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!-- Red left accent border -->
                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="#C62828" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↑ PENGELUARAN"
                                android:textColor="#64748B"
                                android:textSize="10.5sp"
                                android:fontFamily="@font/poppins_bold"
                                android:letterSpacing="0.04" />

                            <TextView
                                android:id="@+id/tv_pengeluaran"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Rp 12.5M"
                                android:textColor="#C62828"
                                android:textSize="16sp"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:id="@+id/tv_badge_pengeluaran"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="↓ Lebih hemat"
                                android:textColor="#C62828"
                                android:textSize="10sp"
                                android:fontFamily="@font/poppins_medium"
                                android:background="@drawable/bg_badge_red"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp" />

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- SECTION TITLE: Manajemen Kebun -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Manajemen Kebun"
                android:textColor="#0D2617"
                android:textSize="14.5sp"
                android:fontFamily="@font/poppins_bold" />

            <!-- MENU GRID TANPA STROKE & TANPA CLIPPING SHADOW -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:clipToPadding="false"
                android:clipChildren="false">

                <!-- Edukasi -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_edukasi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:useCompatPadding="true"
                    app:strokeWidth="0dp"
                    app:strokeColor="@android:color/transparent"
                    app:cardBackgroundColor="@color/white"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:strokeColor="@android:color/transparent"
                            app:cardBackgroundColor="@color/info_blue_light">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_edukasi"
                                app:tint="@color/info_blue"
                                android:contentDescription="Edukasi" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Edukasi"
                            android:textColor="#0D2617"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Input Kegiatan -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_input_kegiatan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:useCompatPadding="true"
                    app:strokeWidth="0dp"
                    app:strokeColor="@android:color/transparent"
                    app:cardBackgroundColor="@color/white"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:strokeColor="@android:color/transparent"
                            app:cardBackgroundColor="@color/secondary_light">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_aktivitas"
                                app:tint="@color/secondary_dark"
                                android:contentDescription="Input Kegiatan" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Input Kegiatan"
                            android:textColor="#0D2617"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pemasukan -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_pemasukan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:useCompatPadding="true"
                    app:strokeWidth="0dp"
                    app:strokeColor="@android:color/transparent"
                    app:cardBackgroundColor="@color/white"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:strokeColor="@android:color/transparent"
                            app:cardBackgroundColor="#E8ECE9">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_income"
                                app:tint="#1B4D2E"
                                android:contentDescription="Pemasukan" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Pemasukan"
                            android:textColor="#0D2617"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pengeluaran -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_pengeluaran"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:useCompatPadding="true"
                    app:strokeWidth="0dp"
                    app:strokeColor="@android:color/transparent"
                    app:cardBackgroundColor="@color/white"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:strokeColor="@android:color/transparent"
                            app:cardBackgroundColor="#FFEBEE">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_outcome"
                                app:tint="#C62828"
                                android:contentDescription="Pengeluaran" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Pengeluaran"
                            android:textColor="#0D2617"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- QUOTE HARI INI DENGAN SOFT SHADOW -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:useCompatPadding="true"
                app:strokeWidth="0dp"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="#F4F7F4">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Dekorasi tanda kutip besar di background -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="-8dp"
                        android:layout_marginEnd="16dp"
                        android:text="\u201C"
                        android:textSize="100sp"
                        android:textColor="#D8E4D8"
                        android:fontFamily="serif" />

                    <!-- Konten -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Label atas -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <!-- Garis aksen kecil -->
                            <View
                                android:layout_width="3dp"
                                android:layout_height="14dp"
                                android:background="#1B4D2E"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QUOTE HARI INI"
                                android:textColor="#1B4D2E"
                                android:textSize="10.5sp"
                                android:letterSpacing="0.12"
                                android:fontFamily="@font/poppins_bold" />
                        </LinearLayout>

                        <!-- Teks quote -->
                        <TextView
                            android:id="@+id/tvQuote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Keuntungan besar dimulai dari pencatatan kecil yang konsisten."
                            android:textColor="#1B4D2E"
                            android:textSize="14.5sp"
                            android:lineSpacingMultiplier="1.4"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="14dp"/>

                        <!-- Divider tipis -->
                        <View
                            android:layout_width="40dp"
                            android:layout_height="1.5dp"
