<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- TOP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        app:elevation="8dp"
        android:outlineProvider="bounds"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStart="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:orientation="horizontal">

                <!-- Logo Box -->
                <androidx.cardview.widget.CardView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="10dp"
                    app:cardBackgroundColor="@color/agri_green_light"
                    app:cardElevation="3dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/logo"
                        android:contentDescription="Logo" />

                </androidx.cardview.widget.CardView>

                <!-- Greeting -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selamat datang 👋"
                        android:textColor="#999999"
                        android:textSize="12sp"
                        android:textStyle="normal" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Halo, "
                            android:textColor="#002617"
                            android:textSize="17sp"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:id="@+id/username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dika!"
                            android:textColor="#1B4D2E"
                            android:textSize="17sp"
                            android:fontFamily="@font/poppins_bold" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Avatar -->
                <FrameLayout
                    android:id="@+id/btnProfileContainer"
                    android:layout_width="39dp"
                    android:layout_height="39dp">

                    <TextView
                        android:id="@+id/tvInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_avatar_circle"/>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="1dp"
                        android:scaleType="centerCrop"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/agri_green_dark"
                        app:shapeAppearanceOverlay="@style/CircleImage"/>

                </FrameLayout>

            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- HEADER DROP SHADOW -->
    <View
        android:id="@+id/view_header_shadow"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@drawable/bg_header_shadow"
        app:layout_constraintTop_toBottomOf="@+id/appBar" />

    <!-- SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/appBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="80dp">

            <!-- ALERT TAHUN TANAM KOSONG -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAlertTahunTanam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFF3E0"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_dialog_alert"
                            app:tint="#E65100" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Tahun tanam lahan Anda masih kosong. Silakan lengkapi data lahan agar fitur aplikasi dapat berjalan maksimal."
                            android:textColor="#E65100"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIsiTahunTanam"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#E65100"
                        android:fontFamily="@font/poppins_semibold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="16dp"
                        android:text="Isi Sekarang"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        app:cornerRadius="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BANNER PANEN -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_bulanan"
                        android:scaleType="centerCrop"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mei 2026"
                            android:textColor="#99FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Total Panen Bulan Ini"
                            android:textColor="#B3FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/tv_total_panen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="12.4 Ton"
                            android:textColor="@color/white"
                            android:textSize="34sp"
                            android:fontFamily="@font/poppins_bold"
                            android:letterSpacing="-0.03" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="↑ +8% dari bulan lalu"
                            android:textColor="#99FFFFFF"
                            android:textSize="12sp" />

                    </LinearLayout>

                </FrameLayout>

            </androidx.cardview.widget.CardView>


            <!-- PEMASUKAN & PENGELUARAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Pemasukan Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!-- Green left border -->
                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="#1B4D2E" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↓ PEMASUKAN"
                                android:textColor="#999999"
                                android:textSize="11sp"
                                android:fontFamily="@font/poppins_bold"
                                android:letterSpacing="0.03" />

                            <TextView
                                android:id="@+id/tv_pemasukan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Rp 45.0M"
                                android:textColor="#1B4D2E"
                                android:textSize="17sp"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:id="@+id/tv_badge_pemasukan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="↑ Bulan ini"
                                android:textColor="#1B4D2E"
                                android:textSize="10sp"
                                android:background="@drawable/bg_badge_green"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp" />

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Pengeluaran Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!-- Red left border -->
                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="#C62828" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↑ PENGELUARAN"
                                android:textColor="#999999"
                                android:textSize="11sp"
                                android:fontFamily="@font/poppins_bold"
                                android:letterSpacing="0.03" />

                            <TextView
                                android:id="@+id/tv_pengeluaran"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Rp 12.5M"
                                android:textColor="#C62828"
                                android:textSize="17sp"
                                android:fontFamily="@font/poppins_bold" />

                            <TextView
                                android:id="@+id/tv_badge_pengeluaran"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="↓ Lebih hemat"
                                android:textColor="#C62828"
                                android:textSize="10sp"
                                android:background="@drawable/bg_badge_red"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp" />

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- SECTION TITLE: Manajemen Kebun -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Manajemen Kebun"
                android:textColor="#444444"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_bold" />

            <!-- MENU GRID -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Edukasi -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_edukasi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8ECE9">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_edukasi"
                                app:tint="#1B4D2E"
                                android:contentDescription="Edukasi" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Edukasi"
                            android:textColor="#002617"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_bold" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Input Kegiatan -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_input_kegiatan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E3F2FD">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_aktivitas"
                                app:tint="#1565C0"
                                android:contentDescription="Input Kegiatan" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Input Kegiatan"
                            android:textColor="#002617"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_bold" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Pemasukan -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_pemasukan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8ECE9">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_pemasukan"
                                app:tint="#1B4D2E"
                                android:contentDescription="Pemasukan" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Pemasukan"
                            android:textColor="#002617"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_bold" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Pengeluaran -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_pengeluaran"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFEBEE">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_pengeluaran"
                                app:tint="#C62828"
                                android:contentDescription="Pengeluaran" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Pengeluaran"
                            android:textColor="#002617"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_bold" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>
            <!-- QUOTE HARI INI -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E8ECE9"> <!-- Menggunakan warna hijau soft senada dengan icon menu -->

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Dekorasi tanda kutip besar di background -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="-8dp"
                        android:layout_marginEnd="16dp"
                        android:text="\u201C"
                        android:textSize="100sp"
                        android:textColor="#C8D8C8"
                    android:fontFamily="serif" />

                    <!-- Konten -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Label atas -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <!-- Garis aksen kecil -->
                            <View
                                android:layout_width="3dp"
                                android:layout_height="14dp"
                                android:background="#1B4D2E"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QUOTE HARI INI"
                                android:textColor="#1B4D2E"
                                android:textSize="10sp"
                                android:letterSpacing="0.15" android:fontFamily="@font/poppins_bold" />
                        </LinearLayout>

                        <!-- Teks quote -->
                        <TextView
                            android:id="@+id/tvQuote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Keuntungan besar dimulai dari pencatatan kecil yang konsisten."
                            android:textColor="#1B4D2E"
                            android:textSize="15sp"
                            android:lineSpacingMultiplier="1.5"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginBottom="16dp"/>

                        <!-- Divider tipis -->
                        <View
                            android:layout_width="40dp"
                            android:layout_height="1.5dp"
                            android:background="#A5D6A7"
                            android:layout_marginBottom="12dp"/>

                        <!-- Atribusi -->
                        <TextView
                            android:id="@+id/createdBy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="— Pepatah Petani"
                            android:textColor="#5A7D5A"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular"/>

                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
