<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Utils.StatusSplashActivity">

    <!-- Header Brand SILAUSA -->
    <LinearLayout
        android:id="@+id/headerBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="36dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo SILAUSA" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="SILAUSA"
            android:fontFamily="@font/poppins_bold"
            android:textSize="18sp"
            android:textColor="#1B4D2E"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Konten Tengah Status Feedback -->
    <LinearLayout
        android:id="@+id/llCenterStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@+id/headerBrand"
        app:layout_constraintBottom_toTopOf="@+id/llBottomAction">

        <!-- 1. Tampilan Video Animasi untuk Status SUKSES -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardVideoSuccess"
            android:layout_width="220dp"
            android:layout_height="330dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#EAEAE9">

            <ImageView
                android:id="@+id/ivSuccessVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Animasi Sawit Berhasil" />
        </androidx.cardview.widget.CardView>

        <!-- 2. Tampilan Badge Error untuk Status GAGAL -->
        <FrameLayout
            android:id="@+id/badgeErrorContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_error">

                <ImageView
                    android:id="@+id/ivErrorIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close"
                    app:tint="#FFFFFF"
                    android:contentDescription="Error Icon" />
            </FrameLayout>
        </FrameLayout>

        <!-- Judul Status: "Berhasil Disimpan!" / "Data Belum Lengkap!" -->
        <TextView
            android:id="@+id/tvStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Berhasil Disimpan!"
            android:fontFamily="@font/poppins_bold"
            android:textSize="22sp"
            android:textColor="#1B4D2E"
            android:gravity="center" />

        <!-- Kategori Chip (Hidden di mode berhasil) -->
        <TextView
            android:id="@+id/tvCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_circle_indicator"
            android:backgroundTint="#FFEBEE"
            android:text="Periksa Input"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="12sp"
            android:textColor="#D32F2F"
            android:visibility="gone" />

        <!-- Pesan Penjelas (Muncul HANYA di Status Gagal agar form error jelas) -->
        <TextView
            android:id="@+id/tvStatusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            android:text=""
            android:fontFamily="@font/poppins_regular"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bagian Bawah: Progress Bar & Tombol Aksi -->
    <LinearLayout
        android:id="@+id/llBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Progress Bar Auto-Dismiss (Hanya Muncul di Status Sukses) -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressAutoClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:progress="0"
            app:indicatorColor="#1B4D2E"
            app:trackColor="#EAEAEA"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp" />

        <!-- Tombol Aksi (Selesai / Periksa Kembali) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusAction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#1B4D2E"
            android:text="Selesai"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
