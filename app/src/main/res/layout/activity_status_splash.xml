<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Utils.StatusSplashActivity">

    <!-- Header Brand SILAUSA -->
    <LinearLayout
        android:id="@+id/headerBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo SILAUSA" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="SILAUSA"
            android:fontFamily="@font/poppins_bold"
            android:textSize="18sp"
            android:textColor="#1B4D2E"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Konten Tengah Status Feedback -->
    <LinearLayout
        android:id="@+id/llCenterStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@+id/headerBrand"
        app:layout_constraintBottom_toTopOf="@+id/llBottomAction">

        <!-- Badge Karakter Sawit & Ikon Status (Centang/Silang) -->
        <FrameLayout
            android:id="@+id/badgeContainer"
            android:layout_width="140dp"
            android:layout_height="140dp">

            <!-- Lingkaran Luar Karakter Sawit -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMascotCircle"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                app:cardCornerRadius="65dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#EAEAE9">

                <ImageView
                    android:id="@+id/ivMascot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sawit_mascot"
                    android:contentDescription="Karakter Sawit" />
            </androidx.cardview.widget.CardView>

            <!-- Lencana Status Mengambang (Pojok Kanan Bawah) -->
            <FrameLayout
                android:id="@+id/badgeStatus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle_success"
                android:elevation="10dp">

                <ImageView
                    android:id="@+id/ivStatusIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    app:tint="#FFFFFF"
                    android:contentDescription="Status Icon" />
            </FrameLayout>

        </FrameLayout>

        <!-- Judul Status (Berhasil / Gagal) -->
        <TextView
            android:id="@+id/tvStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Data Berhasil Disimpan!"
            android:fontFamily="@font/poppins_bold"
            android:textSize="22sp"
            android:textColor="#1B4D2E"
            android:gravity="center" />

        <!-- Kategori / Jenis Data (Badge Chip) -->
        <TextView
            android:id="@+id/tvCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_circle_indicator"
            android:backgroundTint="#E8ECE9"
            android:text="Data Produksi"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="12sp"
            android:textColor="#1B4D2E" />

        <!-- Pesan Penjelas -->
        <TextView
            android:id="@+id/tvStatusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            android:text="Data telah disimpan ke database lokal dan siap disinkronkan ke server."
            android:fontFamily="@font/poppins_regular"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

    <!-- Bagian Bawah: Progress Bar & Tombol Aksi -->
    <LinearLayout
        android:id="@+id/llBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Progress Bar Auto-Dismiss (Hanya Muncul di Status Sukses) -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressAutoClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:progress="0"
            app:indicatorColor="#1B4D2E"
            app:trackColor="#EAEAEA"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp" />

        <!-- Tombol Aksi (Selesai / Coba Lagi) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusAction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#1B4D2E"
            android:text="Selesai"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

