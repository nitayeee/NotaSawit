<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:id="@+id/main">

    <!-- 1. TOOLBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_toolbar_gradient">

        <!-- Tombol Back -->
        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="#FFFFFF"
                android:contentDescription="Kembali" />
        </LinearLayout>

        <!-- Title + Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar Petani"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/tvToolbarSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wilayah Admin"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Spacer Kanan -->
        <View
            android:layout_width="36dp"
            android:layout_height="36dp" />

    </LinearLayout>

    <!-- 2. GREEN HEADER FILTER & SEARCH SECTION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_toolbar_gradient"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="36dp">

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_white_rounded"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="#1B4D2E"
                android:contentDescription="Search Icon" />

            <EditText
                android:id="@+id/etSearchPetani"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:hint="Cari nama, username, atau desa..."
                android:textColor="#1E293B"
                android:textColorHint="#94A3B8"
                android:fontFamily="@font/poppins_regular"
                android:textSize="13.5sp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_close"
                app:tint="#94A3B8"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Hapus Pencarian" />
        </LinearLayout>

        <!-- Filter Chips: "Desa Saya" vs "Semua Desa" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Chip 1: Desa Saya (Active Default) -->
            <LinearLayout
                android:id="@+id/btnFilterDesaSaya"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_filter_chip_active"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvFilterDesaSaya"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desa Saya"
                    android:textColor="#1B4D2E"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Chip 2: Semua Desa -->
            <LinearLayout
                android:id="@+id/btnFilterSemuaDesa"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filter_chip_inactive"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvFilterSemuaDesa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semua Desa"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/poppins_medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

        </LinearLayout>

        <!-- Counter / Info -->
        <TextView
            android:id="@+id/tvCountPetani"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memuat daftar petani..."
            android:textColor="#CCFFFFFF"
            android:textSize="11.5sp"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- 3. OVERLAPPING SHEET CARD FOR PETANI LIST -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="-24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#F8F9FA">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPetani"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="14dp"
                    android:paddingBottom="24dp" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty State View -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_search"
                    app:tint="#CBD5E1"
                    android:contentDescription="Kosong" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Petani Tidak Ditemukan"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tidak ada data petani yang cocok dengan pencarian atau filter yang dipilih."
                    android:textColor="#64748B"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#1B4D2E"
                    android:text="Tampilkan Semua Petani"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins_semibold"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

