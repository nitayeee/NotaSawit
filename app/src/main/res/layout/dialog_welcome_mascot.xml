<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Card Popup Selamat Datang di Tengah -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="28dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="14dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <!-- Header Kecil SILAUSA -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/logo"
                    android:contentDescription="Logo SILAUSA" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="SILAUSA"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="15sp"
                    android:textColor="#1B4D2E"
                    android:letterSpacing="0.03" />
            </LinearLayout>

            <!-- Wadah Animasi Karakter Sawit Melambai (Tajam & Bersih dalam Card) -->
            <androidx.cardview.widget.CardView
                android:layout_width="240dp"
                android:layout_height="240dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EAEAE9">

                <ImageView
                    android:id="@+id/ivMascot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sawit_wave_card"
                    android:contentDescription="Karakter Sawit Melambai" />
            </androidx.cardview.widget.CardView>

            <!-- Teks Sambutan -->
            <TextView
                android:id="@+id/tvWelcomeGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Selamat Datang! 👋"
                android:fontFamily="@font/poppins_bold"
                android:textSize="20sp"
                android:textColor="#1B4D2E"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvGreetingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Halo, Petani Sawit!"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="15sp"
                android:textColor="#2E7D32"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvGreetingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Senang melihatmu kembali. Selamat beraktivitas!"
                android:fontFamily="@font/poppins_regular"
                android:textSize="12sp"
                android:textColor="#757575"
                android:gravity="center" />

            <!-- Tombol Masuk ke Beranda -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMasuk"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#1B4D2E"
                android:text="Masuk ke Beranda"
                android:textAllCaps="false"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
