<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Autentikasi.Daftar.DataDiri.DataDiriActivity">

    <ImageView
        android:id="@+id/iv_header"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:src="@drawable/gambar_sawit"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_fade"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_fade_header"
        app:layout_constraintBottom_toBottomOf="@id/iv_header" />

    <LinearLayout
        android:id="@+id/indicatorContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/iv_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvStep1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_indicator"
            android:text="1"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textStyle="bold" />

        <View
            android:id="@+id/lineStep1"
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:background="#D6D6D6"
            android:layout_marginHorizontal="8dp" />

        <TextView
            android:id="@+id/tvStep2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_indicator"
            android:text="2"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textStyle="bold" />

        <View
            android:id="@+id/lineStep2"
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:background="#D6D6D6"
            android:layout_marginHorizontal="8dp" />

        <TextView
            android:id="@+id/tvStep3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_indicator"
            android:text="3"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tutorialMessageViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/indicatorContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>