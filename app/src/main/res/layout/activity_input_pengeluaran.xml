<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Pengeluaran.InputPengeluaranActivity">

    <!-- ===================== TOPBAR ===================== -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_toolbar_gradient">

            <!-- Tombol Back -->
            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_toolbar_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="#FFFFFF"
                    android:contentDescription="Kembali" />
            </LinearLayout>

            <!-- Title + Subtitle (tengah) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Input Pengeluaran"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:letterSpacing="0.01"  android:fontFamily="@font/poppins_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Masukkaan pengeluaran sawit anda"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Tombol Riwayat -->
            <LinearLayout
                android:id="@+id/btnRiwayat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_toolbar_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_history"
                    app:tint="#FFFFFF"
                    android:contentDescription="Riwayat" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ===================== SCROLLVIEW FORM ===================== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== BARIS TANGGAL & WAKTU ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="6dp">


                <!-- TANGGAL -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TANGGAL"
                        android:textColor="#1B4D2E"
                        android:textSize="11sp"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="6dp"  android:fontFamily="@font/poppins_bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="#1B4D2E"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#FFFFFF"
                        app:startIconDrawable="@drawable/ic_calendar_month"
                        app:startIconTint="#1B4D2E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTanggal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:inputType="none"
                            android:hint="18 Jan 2026"
                            android:textSize="13sp"
                            android:textColor="#002617" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- WAKTU -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WAKTU"
                        android:textColor="#1B4D2E"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="#1B4D2E"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#FFFFFF"
                        app:startIconDrawable="@drawable/ic_clock"
                        app:startIconTint="#1B4D2E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaktu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:gravity="center"
                            android:hint="10:50"
                            android:textSize="13sp"
                            android:textColor="#002617" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>



            <!-- ===== KATEOGRI PENGELUARAN ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KATEGORI PENGELUARAN"
                android:textColor="#1B4D2E"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp"  android:fontFamily="@font/poppins_bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="#1B4D2E"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="#FFFFFF"
                app:startIconDrawable="@drawable/ic_shovel"
                app:startIconTint="#1B4D2E">

                <AutoCompleteTextView
                    android:id="@+id/spinnerKategori"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pilih kategori pengeluaran"
                    android:inputType="none"
                    android:textColor="#002617"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== NAMA ITEM ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAMA ITEM"
                android:textColor="#1B4D2E"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp"  android:fontFamily="@font/poppins_bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="#1B4D2E"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="#FFFFFF"
                app:startIconDrawable="@drawable/ic_shovel"
                app:startIconTint="#1B4D2E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNamaItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:hint="18 Jan 2026"
                    android:textSize="13sp"
                    android:textColor="#002617" />
            </com.google.android.material.textfield.TextInputLayout>



            <!-- ===== Jumlah dan Laham ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="6dp">


                <!-- JUMLAH -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JUMLAH"
                        android:textColor="#1B4D2E"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="#1B4D2E"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#FFFFFF"
                        app:startIconDrawable="@drawable/ic_package"
                        app:startIconTint="#1B4D2E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_jumlah"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="1"
                            android:inputType="numberDecimal"
                            android:textSize="13sp"
                            android:textColor="#002617" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- LAHAN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UNTUK"
                        android:textColor="#1B4D2E"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="#1B4D2E"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#FFFFFF"
                        app:startIconDrawable="@drawable/ic_map_pin"
                        app:startIconTint="#1B4D2E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPilihLahan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:inputType="none"
                            android:hint="Pilih Lahan"
                            android:textSize="13sp"
                            android:textColor="#002617"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupLahan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleLine="false"
                        app:singleSelection="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== TOTAL ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL"
                android:textColor="#1B4D2E"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp"  android:fontFamily="@font/poppins_bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="#1B4D2E"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="#FFFFFF"
                app:startIconDrawable="@drawable/ic_shovel"
                app:startIconTint="#1B4D2E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:hint="Rp 350000"
                    android:textSize="13sp"
                    android:textColor="#002617" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== Catatan Tambahan ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATATAN TAMBAHAN"
                android:textColor="#1B4D2E"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp"  android:fontFamily="@font/poppins_bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="#1B4D2E"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="#FFFFFF"
                app:startIconTint="#1B4D2E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCatatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Masukkan catatan"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top"
                    android:textSize="13sp"
                    android:textColor="#002617" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== BUKTI NOTA ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUKTI NOTA"
                android:textColor="#1B4D2E"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"  android:fontFamily="@font/poppins_bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUploadNota"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1B4D2E"
                app:cardBackgroundColor="#FAFFFA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/imgUploadIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_camera" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tambah Bukti Nota"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="#1B4D2E"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ambil foto atau pilih dari galeri"
                        android:textSize="12sp"
                        android:textColor="#1B4D2E"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Preview gambar -->
            <ImageView
                android:id="@+id/imgNotaPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:background="@drawable/bg_rounded_12" />




            <!-- ===== TOMBOL SIMPAN ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="20dp"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/agri_green_dark"
                android:text="Simpan Kegiatan"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                app:icon="@drawable/ic_save"
                app:iconTint="#FFFFFF"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:iconGravity="textStart"
                app:elevation="4dp" />



        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
