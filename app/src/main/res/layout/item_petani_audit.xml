<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header (Selalu Tampil) -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivProfil"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_profile"
                android:background="@drawable/bg_avatar_circle"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNamaPetani"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Petani"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/black"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum Audit"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/rounded_bg_gray"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tvDesa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Desa"
                    android:textSize="12sp"
                    android:textColor="#757575" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivExpand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_drop_down" />
        </LinearLayout>

        <!-- Detail (Accordion, default GONE) -->
        <LinearLayout
            android:id="@+id/layoutDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#F9F9F9"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTanggalAudit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tanggal Audit: -"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBukaPdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buka PDF"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:strokeColor="@color/agri_green_dark"
                    android:textColor="@color/agri_green_dark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAudit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lakukan Audit"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/agri_green_dark" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
