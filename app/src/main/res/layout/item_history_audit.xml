<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/rounded_bg_gray"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAttemptTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audit ke-1 (2026-07-21)"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAuditorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auditor: Budi Santoso"
                android:fontFamily="@font/poppins"
                android:textColor="#757575"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_bg_gray"
                android:fontFamily="@font/poppins_medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Perlu Perbaikan"
                android:textColor="@color/black"
                android:textSize="10sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBukaPdfHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#1B4D2E"
            android:fontFamily="@font/poppins_medium"
            android:text="PDF"
            android:textColor="@color/white"
            android:textSize="10sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp" />
    </LinearLayout>
</LinearLayout>
