<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    app:useCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Badge Singkatan Bulan -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#C8E6C9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvItemBulanAbbr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="NOV"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvItemTahunAbbr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="'26"
                    android:textColor="#2D6A4F"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Detail Bulan & Pendapatan -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemBulanNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="November 2026"
                android:textColor="#0D2617"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvItemTransaksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/poppins_regular"
                android:text="2 Transaksi Panen"
                android:textColor="#64748B"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvItemPendapatan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_medium"
                android:text="Rp 137.000"
                android:textColor="#10B981"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Total Berat & Badge Tren -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemTotalPanen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="40 Kg"
                android:textColor="@color/primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvItemTonUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="0.04 Ton"
                android:textColor="#64748B"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvItemBadgeTren"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_green"
                android:fontFamily="@font/poppins_medium"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="↑ +8%"
                android:textColor="@color/primary"
                android:textSize="10.5sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

