<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".Autentikasi.Masuk.LupaPinActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header Atas (Gambar Sawit + Tombol Kembali + Logo SILAUSA) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_header"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:src="@drawable/gambar_sawit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/view_fade"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_fade_header"
                app:layout_constraintBottom_toBottomOf="@+id/iv_header"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Tombol Kembali Bulat -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_circle_back"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Kembali"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- Logo Box SILAUSA -->
            <LinearLayout
                android:id="@+id/logo_box"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="50dp"
                android:background="@drawable/bg_logo_shadow"
                android:elevation="8dp"
                android:gravity="center"
                android:padding="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/logo" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_bold"
                android:text="SILAUSA"
                android:textColor="@color/agri_green_dark"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logo_box" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Judul & Subtitle Halaman -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Reset PIN Akun"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:text="Verifikasi email akun Anda untuk mengatur ulang 6-digit PIN"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Konten Form Lupa PIN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp">

            <!-- ============================================== -->
            <!-- TAHAP 1: PILIH / MASUKKAN EMAIL AKUN           -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/layoutPilihEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Tombol Cepat: Pilih Email dengan Akun Google -->
                <LinearLayout
                    android:id="@+id/btnPilihGoogleEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_google_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/google" />

                    <TextView
                        android:id="@+id/tv_google_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Pilih Email dengan Google"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <ProgressBar
                        android:id="@+id/pb_google_loading"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:indeterminateTint="@color/agri_green_dark"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Divider atau ketik manual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:alpha="0.25"
                        android:background="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="atau masukkan email manual"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:alpha="0.25"
                        android:background="@color/text_secondary" />
                </LinearLayout>

                <!-- Input Email Manual -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Email Terdaftar"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_dialog_email"
                        app:tint="@color/text_secondary" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center_vertical"
                        android:hint="contoh: nama@email.com"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Tombol Periksa Email -->
                <LinearLayout
                    android:id="@+id/btnPeriksaEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center">

                    <ProgressBar
                        android:id="@+id/pbPeriksaEmail"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvPeriksaEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Periksa Email"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>

            </LinearLayout>


            <!-- ============================================== -->
            <!-- CARD AKUN TERVERIFIKASI (MUNCUL JIKA EMAIL ADA) -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/cardAkunTerverifikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_verified"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/agri_green_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Akun Ditemukan &amp; Terverifikasi"
                        android:textColor="@color/agri_green_dark"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNamaAkun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Pemilik Akun: Budi Santoso (Petani)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvEmailTerverifikasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Email: budi@gmail.com"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/btnGantiEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingVertical="4dp"
                    android:text="Ganti / Periksa Email Lain"
                    android:textColor="@color/agri_green_dark"
                    android:textSize="12sp" />
            </LinearLayout>


            <!-- ============================================== -->
            <!-- TAHAP 2: INPUT PIN BARU & VERIFIKASI PIN       -->
            <!-- (HANYA MUNCUL SETELAH EMAIL TERBUKTI ADA)     -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/layoutInputPinBaru"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.2"
                    android:background="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Buat 6-Digit PIN Baru"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Masukkan 6 digit angka yang aman dan mudah Anda ingat"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <!-- Label PIN Baru -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="PIN Baru (6 Digit)"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_lock_idle_lock"
                        app:tint="@color/text_secondary" />

                    <EditText
                        android:id="@+id/etPinBaru"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center_vertical"
                        android:hint="••••••"
                        android:includeFontPadding="false"
                        android:inputType="numberPassword"
                        android:maxLength="6"
                        android:paddingVertical="0dp"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnTogglePinBaru"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:src="@drawable/ic_visibility"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Label Konfirmasi PIN Baru -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Konfirmasi PIN Baru (6 Digit)"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_lock_idle_lock"
                        app:tint="@color/text_secondary" />

                    <EditText
                        android:id="@+id/etKonfirmasiPin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center_vertical"
                        android:hint="••••••"
                        android:includeFontPadding="false"
                        android:inputType="numberPassword"
                        android:maxLength="6"
                        android:paddingVertical="0dp"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnToggleKonfirmasiPin"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:src="@drawable/ic_visibility"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Tombol Simpan PIN Baru -->
                <LinearLayout
                    android:id="@+id/btnSimpanPinBaru"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center">

                    <ProgressBar
                        android:id="@+id/pbSimpanPin"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvSimpanPin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Simpan PIN Baru"
                        android:textColor="@color/white"
                        android:textSize="16sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
