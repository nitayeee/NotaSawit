<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header Petani -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="14dp">

            <TextView
                android:id="@+id/tvSheetInitial"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:fontFamily="@font/poppins_bold"
                android:background="@drawable/bg_circle_avatar_initial"
                android:text="P" />

            <ImageView
                android:id="@+id/ivSheetProfil"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Foto Petani" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Petani"
                android:textColor="#0D2617"
                android:textSize="17sp"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:id="@+id/tvSheetUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\@username"
                android:textColor="#64748B"
                android:textSize="12.5sp"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginTop="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvSheetDesa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desa Kiab Jaya"
                    android:textColor="#166534"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_medium"
                    android:background="@drawable/bg_badge_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />

                <TextView
                    android:id="@+id/tvSheetStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Aktif"
                    android:textColor="#334155"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/poppins_medium"
                    android:background="@drawable/rounded_bg_gray"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Info Detail Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E2E8F0"
        app:cardBackgroundColor="#F8FAFC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ID Petani Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="ID Petani"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/tvSheetId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="#27"
                    android:textColor="#1E293B"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/poppins_semibold" />
            </LinearLayout>

            <!-- Nomor HP / WhatsApp Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Nomor HP"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/tvSheetNoHp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0812-xxxx-xxxx"
                    android:textColor="#1E293B"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>

            <!-- Email Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/tvSheetEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="#1E293B"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>

            <!-- Alamat Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Alamat"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/tvSheetAlamat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="#1E293B"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tombol Aksi: WhatsApp & Peta Lahan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tombol Chat WA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetWa"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#25D366"
            android:text="Hubungi via WhatsApp"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="13.5sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_whatsapp"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Tombol Lihat di Peta Lahan -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetPeta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:text="Lihat Lahan di Peta"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="13.5sp"
            android:textColor="#1B4D2E"
            app:strokeColor="#1B4D2E"
            app:strokeWidth="1.5dp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Tombol Tutup -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetTutup"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:text="Tutup"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_medium"
            android:textSize="13sp"
            android:textColor="#64748B" />

    </LinearLayout>

</LinearLayout>
