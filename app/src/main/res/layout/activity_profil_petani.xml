<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    tools:context=".ProfilPetani.ProfilPetaniActivity">

    <!-- ===================== 1. TOOLBAR TETAP DI ATAS (FIXED) ===================== -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_toolbar_gradient"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tombol Back -->
        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="#FFFFFF"
                android:contentDescription="Kembali" />
        </LinearLayout>

        <!-- Title Tengah -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profil Anda"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <!-- Tombol Riwayat -->
        <LinearLayout
            android:id="@+id/btnRiwayat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_history"
                app:tint="#FFFFFF"
                android:contentDescription="Riwayat" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== 2. AREA SCROLLABLE (SEMUA MASUK SINI) ===================== -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- FrameLayout digunakan agar Card Putih bisa menimpa/overlap Banner Hijau -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- BANNER BACKGROUND HIJAU (Ikut terscroll) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:orientation="vertical"
                android:background="@drawable/bg_toolbar_gradient"
                android:gravity="center_horizontal">

                <!-- FOTO PROFIL DENGAN STROKE PUTIH -->
                <FrameLayout
                    android:id="@+id/profilePictureContainer"
                    android:layout_width="126dp"
                    android:layout_height="126dp"
                    android:layout_marginTop="8dp">

                    <!-- Card Luar: Stroke Putih -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="116dp"
                        android:layout_height="116dp"
                        android:layout_gravity="center"
                        app:cardCornerRadius="58dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardPreventCornerOverlap="false">

                        <!-- Card Dalam: Kontainer Gambar -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardProfil"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:layout_gravity="center"
                            app:cardCornerRadius="55dp"
                            app:cardElevation="0dp"
                            app:cardPreventCornerOverlap="false">
                            <ImageView
                                android:id="@+id/imgFotoProfil"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/dummy_profile"
                                android:scaleType="centerCrop"
                                android:contentDescription="Foto Profil" />
                        </androidx.cardview.widget.CardView>
                    </androidx.cardview.widget.CardView>

                    <!-- Tombol Ganti Foto / Kamera Mini -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnGantiFoto"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        app:cardCornerRadius="17dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#FFFFFF"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="#2E7D32" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>
            </LinearLayout>

            <!-- KONTEN CARD UTAMA (Mulai dari sini ditumpuk di atas Banner) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="150dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#F4F6F8"
                app:cardUseCompatPadding="false"
                app:cardPreventCornerOverlap="false">
                <!-- KUNCI POSISI: layout_marginTop="150dp" memotong banner hijau tepat di bawah leher foto profil -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="32dp"
                    android:paddingBottom="32dp">

                    <!-- CARD DATA DIRI -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        android:backgroundTint="#F6F6F6"
                        app:cardElevation="2dp"
                        app:cardUseCompatPadding="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="12dp">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="4dp"
                                    android:layout_height="18dp"
                                    app:cardCornerRadius="2dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="#2E7D32"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Data Diri"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#1B5E20" />
                            </LinearLayout>

                            <TextView style="@style/LabelStyle" android:text="Nama Lengkap" />
                            <TextView style="@style/ValueStyle" android:id="@+id/tvNama" android:text="Budi Santoso" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#EFF3EF"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="10dp"/>

                            <TextView style="@style/LabelStyle" android:text="Username" />
                            <TextView style="@style/ValueStyle" android:id="@+id/tvUsername" android:text="budi_sawit99" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#EFF3EF"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="10dp"/>

                            <TextView style="@style/LabelStyle" android:text="Email" />
                            <TextView style="@style/ValueStyle" android:id="@+id/tvEmail" android:text="budisantoso@email.com" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#EFF3EF"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="10dp"/>

                            <TextView style="@style/LabelStyle" android:text="Jenis Kelamin" />
                            <TextView style="@style/ValueStyle" android:id="@+id/tvJenisKelamin" android:text="Laki-laki" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- CARD INFORMASI LAHAN -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        android:backgroundTint="#F6F6F6"
                        app:cardUseCompatPadding="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="14dp">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="4dp"
                                    android:layout_height="18dp"
                                    app:cardCornerRadius="2dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="#2E7D32"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Informasi Lahan"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#1B5E20" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center_horizontal">
                                    <TextView
                                        android:id="@+id/tvJumlahLahan"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="3 Kavling / Blok"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="#2E7D32"
                                        android:gravity="center" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Jumlah Lahan"
                                        android:textSize="11sp"
                                        android:textColor="#888888"
                                        android:layout_marginTop="3dp" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="#EFF3EF" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center_horizontal">
                                    <TextView
                                        android:id="@+id/tvTotalLuas"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="6.5 Hektar"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:textColor="#2E7D32" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Total Luas Lahan"
                                        android:textSize="11sp"
                                        android:textColor="#888888"
                                        android:layout_marginTop="3dp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- TOMBOL EDIT PROFIL -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfil"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Edit Profil Anda"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#2E7D32"
                        app:cornerRadius="26dp"
                        app:icon="@android:drawable/ic_menu_edit"
                        app:iconTint="#FFFFFF"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </FrameLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>