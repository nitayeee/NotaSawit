<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:id="@+id/main"
    tools:context=".Admin.PetaLahan.PetaLahanActivity">

    <!-- 1. TOOLBAR (SAMA SEPERTI AUDIT INTERNAL & KUNJUNGAN LAHAN) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_toolbar_gradient">

        <!-- Tombol Back -->
        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="#FFFFFF"
                android:contentDescription="Kembali" />
        </LinearLayout>

        <!-- Title + Subtitle (tengah) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peta Digital Lahan"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Spacer Kanan untuk Keseimbangan Title -->
        <View
            android:layout_width="36dp"
            android:layout_height="36dp" />

    </LinearLayout>

    <!-- 2. GREEN HEADER FILTER SECTION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_toolbar_gradient"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cari / Filter Petani"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="2dp" />

        <!-- Search Bar with AutoComplete and Clear Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_white_rounded">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="#1B4D2E"
                android:contentDescription="Search Icon" />

            <AutoCompleteTextView
                android:id="@+id/etSearchPetani"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:hint="Ketik atau pilih nama petani..."
                android:textColor="#1E293B"
                android:textColorHint="#94A3B8"
                android:fontFamily="@font/poppins_regular"
                android:textSize="13.5sp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:completionThreshold="1" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_close"
                app:tint="#94A3B8"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Hapus Pencarian" />
        </LinearLayout>

        <!-- Status / Counter Info -->
        <TextView
            android:id="@+id/tvLahanCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memuat data lahan..."
            android:textColor="#CCFFFFFF"
            android:textSize="11.5sp"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- 3. OVERLAPPING SHEET CARD FOR MAP WEBVIEW -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="-24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#F8F9FA">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webViewPeta"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
