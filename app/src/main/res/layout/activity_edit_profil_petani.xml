<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    tools:context=".ProfilPetani.EditProfilPetaniActivity">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/agri_green_dark"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">
        
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profil"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Top Background Curve -->
    <View
        android:id="@+id/headerBg"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/agri_green_dark"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F0F4F1"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="32dp"
                    android:paddingBottom="24dp"
                    android:paddingHorizontal="24dp">

                    <!-- Foto Profil -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="32dp">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center">

                            <androidx.cardview.widget.CardView
                                android:layout_width="104dp"
                                android:layout_height="104dp"
                                app:cardCornerRadius="52dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/agri_green_dark">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="100dp"
                                    android:layout_height="100dp"
                                    app:cardCornerRadius="50dp"
                                    android:layout_gravity="center"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="#E2E8F0">
                                    <TextView
                                        android:id="@+id/tvInitials"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:text=""
                                        android:textSize="36sp"
                                        android:textColor="@color/agri_green_dark"
                                        android:fontFamily="@font/poppins_bold" />
                                    <ImageView
                                        android:id="@+id/imgFotoProfil"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop" />
                                </androidx.cardview.widget.CardView>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnUbahFotoProfilIkon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:cardCornerRadius="16dp"
                                app:cardBackgroundColor="#3B497D"
                                app:cardElevation="2dp"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="4dp"
                                android:layout_marginBottom="4dp">
                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@android:drawable/ic_menu_camera"
                                    android:padding="6dp"
                                    app:tint="#FFFFFF" />
                            </androidx.cardview.widget.CardView>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/btnUbahFotoProfilText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah Foto Profil"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="#3B497D"
                            android:layout_marginTop="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:drawableStart="@android:drawable/ic_menu_edit"
                            android:drawablePadding="6dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F0F4F1"
                android:paddingHorizontal="24dp"
                android:layout_marginTop="24dp">

                <!-- SECTION: INFORMASI PRIBADI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="#3B497D"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INFORMASI PRIBADI"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="#8C93A4" />
                </LinearLayout>

                <!-- Nama Lengkap -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <androidx.cardview.widget.CardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#E6E8F0"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_profile" 
                                app:tint="#8C93A4"/>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nama Lengkap "
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="14sp"
                            android:textColor="#1E293B"
                            android:layout_marginStart="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="14sp"
                            android:textColor="#EF4444" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="0dp">
                        <EditText
                            android:id="@+id/etNama"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@null"
                            android:paddingHorizontal="16dp"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:inputType="textPersonName" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- NIK / Username -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <androidx.cardview.widget.CardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#E6E8F0"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_audit" 
                                app:tint="#8C93A4"/>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Username "
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="14sp"
                            android:textColor="#1E293B"
                            android:layout_marginStart="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="14sp"
                            android:textColor="#EF4444" />
                            
                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="16/16"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="10sp"
                            android:textColor="#10B981" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="0dp">
                        <EditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@null"
                            android:paddingHorizontal="16dp"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:inputType="textPersonName" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Nomor Telepon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <androidx.cardview.widget.CardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#E6E8F0"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_call" 
                                app:tint="#8C93A4"/>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nomor Telepon "
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="14sp"
                            android:textColor="#1E293B"
                            android:layout_marginStart="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="14sp"
                            android:textColor="#EF4444" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="0dp">
                        <EditText
                            android:id="@+id/etNoHp"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@null"
                            android:paddingHorizontal="16dp"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:inputType="phone" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Email Aktif -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="32dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <androidx.cardview.widget.CardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#E6E8F0"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_note" 
                                app:tint="#8C93A4"/>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email Aktif "
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="14sp"
                            android:textColor="#1E293B"
                            android:layout_marginStart="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="14sp"
                            android:textColor="#EF4444" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="0dp">
                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@null"
                            android:paddingHorizontal="16dp"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:inputType="textEmailAddress" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- SECTION: LOKASI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="#3B497D"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOKASI"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="#8C93A4" />
                </LinearLayout>

                <!-- Desa -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <androidx.cardview.widget.CardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#E6E8F0"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_mapmode" 
                                app:tint="#8C93A4"/>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kelurahan / Desa"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="14sp"
                            android:textColor="#1E293B"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="0dp">
                        <AutoCompleteTextView
                            android:id="@+id/spinnerDesa"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@null"
                            android:paddingHorizontal="16dp"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:inputType="none"
                            android:drawableEnd="@android:drawable/arrow_down_float" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Alamat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="32dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <androidx.cardview.widget.CardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#E6E8F0"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_mylocation" 
                                app:tint="#8C93A4"/>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alamat Lengkap"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="14sp"
                            android:textColor="#1E293B"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="0dp">
                        <EditText
                            android:id="@+id/etAlamat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="100dp"
                            android:background="@null"
                            android:padding="16dp"
                            android:gravity="top|start"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:inputType="textMultiLine"
                            android:minLines="3" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Save Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimpan"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Simpan Perubahan"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="16sp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#3B497D" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
