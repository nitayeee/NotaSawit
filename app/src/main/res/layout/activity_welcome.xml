<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAEAE9"
    tools:context=".Autentikasi.Masuk.WelcomeActivity">

    <!-- Header Brand NotaSawit -->
    <LinearLayout
        android:id="@+id/headerBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/gambar_sawit"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_circle_indicator"
            android:padding="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="NotaSawit"
            android:fontFamily="@font/poppins_bold"
            android:textSize="20sp"
            android:textColor="#1B4D2E" />
    </LinearLayout>

    <!-- Wadah Animasi Karakter Sawit Melambai (Tengah) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMascot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#EAEAE9"
        app:layout_constraintDimensionRatio="16:11"
        app:layout_constraintTop_toBottomOf="@+id/headerBrand"
        app:layout_constraintBottom_toTopOf="@+id/cardGreeting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivMascot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/sawit_mascot"
            android:contentDescription="Karakter Sawit Melambai" />

    </androidx.cardview.widget.CardView>

    <!-- Kartu Ucapan Selamat Datang Bawah -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="36dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="24dp">

            <TextView
                android:id="@+id/tvWelcomeGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat Datang! 👋"
                android:fontFamily="@font/poppins_bold"
                android:textSize="22sp"
                android:textColor="#1B4D2E"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Halo, Petani Sawit!"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="16sp"
                android:textColor="#2E7D32"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvSubGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Senang melihatmu kembali. Menyiapkan beranda..."
                android:fontFamily="@font/poppins_regular"
                android:textSize="13sp"
                android:textColor="#757575"
                android:gravity="center" />

            <!-- Indikator Loading Lembut -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressWelcome"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:indeterminate="true"
                app:indicatorColor="#1B4D2E"
                app:trackColor="#E0E0E0"
                app:trackCornerRadius="4dp"
                app:trackThickness="4dp" />

            <!-- Petunjuk Ketuk Layar untuk Lewati -->
            <TextView
                android:id="@+id/btnSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="6dp"
                android:text="Ketuk untuk langsung masuk →"
                android:fontFamily="@font/poppins_medium"
                android:textSize="12sp"
                android:textColor="#888888" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

