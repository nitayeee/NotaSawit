<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAEAE9"
    tools:context=".Autentikasi.Masuk.WelcomeActivity">

    <!-- Header Brand SILAUSA di atas dengan logo -->
    <LinearLayout
        android:id="@+id/headerBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo SILAUSA" />

        <TextView
            android:id="@+id/tvBrandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="SILAUSA"
            android:fontFamily="@font/poppins_bold"
            android:textSize="24sp"
            android:textColor="#1B4D2E"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Konten Tengah: Karakter Sawit Melambai (Besar, Tanpa Card) dan Tulisan Selamat Datang -->
    <LinearLayout
        android:id="@+id/llCenterContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@+id/headerBrand"
        app:layout_constraintBottom_toTopOf="@+id/llBottomSection">

        <!-- Karakter Sawit Melambai (Fleksibel & Maksimal Besarnya) -->
        <ImageView
            android:id="@+id/ivMascot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:src="@drawable/sawit_mascot"
            android:contentDescription="Karakter Sawit Melambai" />

        <!-- Teks Selamat Datang -->
        <TextView
            android:id="@+id/tvWelcomeGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Selamat Datang! 👋"
            android:fontFamily="@font/poppins_bold"
            android:textSize="24sp"
            android:textColor="#1B4D2E"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Halo, Petani Sawit!"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="17sp"
            android:textColor="#2E7D32"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvSubGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Senang melihatmu kembali"
            android:fontFamily="@font/poppins_regular"
            android:textSize="13sp"
            android:textColor="#666666"
            android:gravity="center" />

    </LinearLayout>

    <!-- Bagian Bawah: Progress Bar untuk Pindah ke Homepage -->
    <LinearLayout
        android:id="@+id/llBottomSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menyiapkan beranda..."
            android:fontFamily="@font/poppins_medium"
            android:textSize="13sp"
            android:textColor="#1B4D2E" />

        <!-- Linear Progress Bar Animasi 0% -> 100% -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:progress="0"
            app:indicatorColor="#1B4D2E"
            app:trackColor="#C8CCD0"
            app:trackCornerRadius="6dp"
            app:trackThickness="6dp" />

        <!-- Hint Ketuk Layar untuk Langsung Masuk -->
        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="6dp"
            android:text="Ketuk untuk langsung masuk →"
            android:fontFamily="@font/poppins_regular"
            android:textSize="12sp"
            android:textColor="#777777" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
