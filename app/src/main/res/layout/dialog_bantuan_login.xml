<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Dialog -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_help"
                app:tint="@color/agri_green_dark"
                android:contentDescription="Bantuan" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="Bantuan Masuk Akun"
                android:textColor="@color/agri_green_dark"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/btnCloseDialog"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary"
                android:contentDescription="Tutup" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Ketik Nama Lengkap Anda untuk terhubung ke nomor WhatsApp Admin Desa Anda."
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:lineSpacingExtra="2dp" />

        <!-- Input Nama Petani -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Nama Lengkap Anda"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_name"
                app:tint="@color/text_secondary"
                android:contentDescription="Nama" />

            <AutoCompleteTextView
                android:id="@+id/actvNamaPetani"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:fontFamily="@font/poppins_regular"
                android:hint="Contoh: Dariani"
                android:inputType="textPersonName|textCapWords"
                android:completionThreshold="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Card Informasi Desa & Admin (Muncul/Diperbarui otomatis) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfoAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#C8E6C9"
            app:cardBackgroundColor="#F1F8F2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLabelDesa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_bold"
                        android:text="📍 Wilayah: Memilih Desa..."
                        android:textColor="@color/agri_green_dark"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvBadgeAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_circle_indicator"
                        android:backgroundTint="#E8ECE9"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="Admin Desa"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/agri_green_dark"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNamaAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Admin: Siap menghubungkan..."
                    android:textColor="#374151"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol Kirim WhatsApp Langsung -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKirimWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#1B4D2E"
            android:text="Chat WhatsApp Admin"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="14sp"
            android:textColor="@color/white"
            app:icon="@drawable/ic_whatsapp"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:cornerRadius="14dp" />

        <!-- Alternatif: Reset PIN Mandiri -->
        <TextView
            android:id="@+id/btnResetPinMandiri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:fontFamily="@font/poppins_medium"
            android:text="Atau Reset PIN Mandiri via Email"
            android:textColor="@color/agri_green_dark"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

