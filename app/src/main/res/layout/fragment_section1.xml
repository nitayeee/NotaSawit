<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Section 1: Data Identitas Audit"
            android:textColor="#002617"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginBottom="24dp" />

        <!-- 1. TANGGAL AUDIT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tanggal Audit"
            android:textColor="#4A5568"
            android:textSize="13.5sp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etTanggal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_soft"
            android:paddingHorizontal="16dp"
            android:hint="DD/MM/YYYY"
            android:inputType="date"
            android:textColor="#1A202C"
            android:textColorHint="#A0AEC0"
            android:fontFamily="@font/poppins_regular"
            android:textSize="14sp"
            android:layout_marginBottom="18dp" />

        <!-- 2. DESA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desa"
            android:textColor="#4A5568"
            android:textSize="13.5sp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etDesa"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_soft"
            android:paddingHorizontal="16dp"
            android:hint="Nama desa"
            android:enabled="false"
            android:textColor="#1A202C"
            android:textColorHint="#A0AEC0"
            android:fontFamily="@font/poppins_regular"
            android:textSize="14sp"
            android:layout_marginBottom="18dp" />

        <!-- 3. NAMA AUDITOR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Auditor"
            android:textColor="#4A5568"
            android:textSize="13.5sp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etAuditor"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_soft"
            android:paddingHorizontal="16dp"
            android:hint="Nama auditor"
            android:enabled="false"
            android:textColor="#1A202C"
            android:textColorHint="#A0AEC0"
            android:fontFamily="@font/poppins_regular"
            android:textSize="14sp"
            android:layout_marginBottom="18dp" />

        <!-- 4. NAMA PETANI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Petani"
            android:textColor="#4A5568"
            android:textSize="13.5sp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPetani"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_soft"
            android:paddingHorizontal="16dp"
            android:hint="Nama petani"
            android:enabled="false"
            android:textColor="#1A202C"
            android:textColorHint="#A0AEC0"
            android:fontFamily="@font/poppins_regular"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnLanjut"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="LANJUT KE SECTION 2"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_bold"
            app:backgroundTint="@color/secondary"
            android:textColor="@color/tertiary"/>

    </LinearLayout>
</ScrollView>
