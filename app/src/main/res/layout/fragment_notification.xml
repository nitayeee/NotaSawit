<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_toolbar_gradient">



        <!-- Title + Subtitle (tengah) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notifikasi"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lihat Notifikasi Anda!"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>



    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#F5F5F5">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterSemua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semua"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_badge_green"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/filterBelum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum Dibaca"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="#2B462C"
                android:background="@drawable/bg_badge_green"
                android:backgroundTint="#E8EEE8"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/filterSudah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sudah Dibaca"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="#2B462C"
                android:background="@drawable/bg_badge_green"
                android:backgroundTint="#E8EEE8"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="20dp"/>

    <LinearLayout
        android:id="@+id/panelSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnBatalSeleksi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Batal"
            android:textColor="#333333"
            android:backgroundTint="#EEEEEE"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnTandaiDibaca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tandai Dibaca (0)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2B462C"/>

    </LinearLayout>

</LinearLayout>
