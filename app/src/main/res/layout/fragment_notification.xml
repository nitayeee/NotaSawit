<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- TOOLBAR (PERSIS AUDIT INTERNAL & FORM INPUT) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_toolbar_gradient">

        <!-- Title + Subtitle (Tengah) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pusat Notifikasi"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informasi &amp; Pembaruan Kebun Sawit"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="1dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- CONTENT WRAPPER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- BANNER HEADER SECTION (PERSIS AUDIT INTERNAL & FORM INPUT) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F4F7F4">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/primary"
                        android:contentDescription="Icon Notifikasi" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PUSAT NOTIFIKASI"
                        android:textColor="@color/secondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informasi &amp; Pemberitahuan"
                        android:textColor="@color/tertiary"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginTop="1dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pantau riwayat audit, transaksi &amp; kegiatan"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FILTER TABS HORIZONTAL -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:background="#F8F9FA">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/filterSemua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semua"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_chip_active"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="12.5sp"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/filterBelum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum Dibaca"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:textColor="#1B4D2E"
                    android:background="@drawable/bg_chip_inactive"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="12.5sp"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/filterSudah"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sudah Dibaca"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:textColor="#1B4D2E"
                    android:background="@drawable/bg_chip_inactive"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="12.5sp"
                    android:layout_marginEnd="10dp"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- LIST RECYCLER VIEW -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp"/>

    </LinearLayout>

    <!-- PANEL SELEKSI BOTTOM BAR -->
    <LinearLayout
        android:id="@+id/panelSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="12dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatalSeleksi"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Batal"
            android:textColor="#64748B"
            app:backgroundTint="#F1F5F9"
            app:cornerRadius="10dp"
            android:fontFamily="@font/poppins_bold"
            android:textAllCaps="false"
            android:layout_marginEnd="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTandaiDibaca"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Tandai Dibaca (0)"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/primary"
            app:cornerRadius="10dp"
            android:fontFamily="@font/poppins_bold"
            android:textAllCaps="false"/>

    </LinearLayout>

</LinearLayout>
