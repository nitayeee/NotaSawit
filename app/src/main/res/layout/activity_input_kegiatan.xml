<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F3"
    tools:context=".InputKegiatan.InputKegiatanActivity">

    <!-- ===================== TOOLBAR ===================== -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_toolbar_gradient">

            <!-- Tombol Back -->
            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_toolbar_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="#FFFFFF"
                    android:contentDescription="Kembali" />
            </LinearLayout>

            <!-- Title + Subtitle (tengah) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Input Kegiatan"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_bold"
                    android:letterSpacing="0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kebun Sawit · Blok A3"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Tombol Riwayat -->
            <LinearLayout
                android:id="@+id/btnRiwayat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_toolbar_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_history"
                    app:tint="#FFFFFF"
                    android:contentDescription="Riwayat" />
            </LinearLayout>

        </LinearLayout>



    </LinearLayout>

    <!-- ===================== SCROLLVIEW FORM ===================== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== BARIS TANGGAL & WAKTU ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- TANGGAL -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TANGGAL"
                        android:textColor="#1B4D2E"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="#1B4D2E"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#FFFFFF"
                        app:startIconDrawable="@drawable/ic_calendar_month"
                        app:startIconTint="#1B4D2E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTanggal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:inputType="none"
                            android:hint="18 Jan 2026"
                            android:textSize="13sp"
                            android:textColor="#002617" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- WAKTU -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WAKTU"
                        android:textColor="#1B4D2E"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="#1B4D2E"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#FFFFFF"
                        app:startIconDrawable="@drawable/ic_clock"
                        app:startIconTint="#1B4D2E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaktu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:gravity="center"
                            android:hint="10:50"
                            android:textSize="13sp"
                            android:textColor="#002617" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== DIVIDER: DETAIL KEGIATAN ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8ECE9" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  DETAIL KEGIATAN  "
                    android:textColor="#1B4D2E"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_bold"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8ECE9" />
            </LinearLayout>

            <!-- ===== JENIS KEGIATAN ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JENIS KEGIATAN"
                android:textColor="#1B4D2E"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="#1B4D2E"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="#FFFFFF"
                app:startIconDrawable="@drawable/ic_shovel"
                app:startIconTint="#1B4D2E">

                <AutoCompleteTextView
                    android:id="@+id/spinnerKegiatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pilih Kegiatan (Mupuk / Panen / Semprot)"
                    android:inputType="none"
                    android:textSize="13sp"
                    android:textColor="#002617" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== BAHAN / HASIL KERJA ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BAHAN / HASIL KERJA"
                android:textColor="#1B4D2E"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.06"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="#1B4D2E"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="#FFFFFF"
                app:startIconDrawable="@drawable/ic_package"
                app:startIconTint="#1B4D2E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBahan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Contoh: Pupuk NPK Mahkota / Egrek"
                    android:textSize="13sp"
                    android:textColor="#002617" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== BARIS DOSIS & LAHAN ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:baselineAligned="false">

                <!-- DOSIS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DOSIS / JUMLAH"
                        android:textColor="#1B4D2E"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="#1B4D2E"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#FFFFFF"
                        app:startIconDrawable="@drawable/ic_calculator"
                        app:startIconTint="#1B4D2E"
                        app:suffixText="kg"
                        app:suffixTextColor="#1B4D2E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDosis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:hint="1"
                            android:textSize="13sp"
                            android:textColor="#002617" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LAHAN"
                        android:textColor="#1B4D2E"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="#1B4D2E"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#FFFFFF"
                        app:startIconDrawable="@drawable/ic_map_pin"
                        app:startIconTint="#1B4D2E">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPilihLahan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:inputType="none"
                            android:hint="Pilih Lahan"
                            android:textSize="13sp"
                            android:textColor="#002617"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupLahan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleLine="false"
                        app:singleSelection="false"/>

                </LinearLayout>
            </LinearLayout>
            <!-- LAHAN -->


            <!-- ===== DIVIDER: TENAGA & BIAYA ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8ECE9" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  TENAGA &amp; BIAYA  "
                    android:textColor="#1B4D2E"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_bold"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8ECE9" />
            </LinearLayout>

            <!-- ===== TENAGA KERJA ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TENAGA KERJA"
                android:textColor="#1B4D2E"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="#1B4D2E"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="#FFFFFF"
                app:startIconDrawable="@drawable/ic_users"
                app:startIconTint="#1B4D2E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTenagaKerja"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Upah Harian / Borongan"
                    android:textSize="13sp"
                    android:textColor="#002617" />
            </com.google.android.material.textfield.TextInputLayout>



            <!-- ===== TOMBOL SIMPAN ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="20dp"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/agri_green_dark"
                android:text="Simpan Kegiatan"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                app:icon="@drawable/ic_save"
                app:iconTint="#FFFFFF"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:iconGravity="textStart"
                app:elevation="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
