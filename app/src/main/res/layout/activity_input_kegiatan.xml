<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".InputKegiatan.InputKegiatanActivity">

    <!-- ===================== TOOLBAR (PERSIS SEPERTI AUDIT INTERNAL) ===================== -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_toolbar_gradient">

            <!-- Tombol Back -->
            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_toolbar_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="#FFFFFF"
                    android:contentDescription="Kembali" />
            </LinearLayout>

            <!-- Title + Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Input Kegiatan Kebun"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_bold"
                    android:letterSpacing="0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pencatatan Racun, Pemupukan &amp; Limbah"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Tombol Riwayat -->
            <LinearLayout
                android:id="@+id/btnRiwayat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_toolbar_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_history"
                    app:tint="#FFFFFF"
                    android:contentDescription="Riwayat Kegiatan" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ===================== SCROLLVIEW FORM (STYLE AUDIT INTERNAL) ===================== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Banner Header Section (Persis Audit Internal) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F4F7F4">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shovel"
                            app:tint="@color/primary"
                            android:contentDescription="Icon Kegiatan" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FORM KEGIATAN"
                            android:textColor="@color/secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Penggunaan Bahan &amp; Limbah"
                            android:textColor="@color/tertiary"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins_bold"
                            android:layout_marginTop="1dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lengkapi rincian kegiatan kebun sawit"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD CONTAINER 1: WAKTU & LOKASI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 1. TANGGAL RENCANA / PELAKSANAAN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tanggal Pelaksanaan"
                            android:textColor="@color/tertiary"
                            android:textSize="13.5sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*Wajib"
                            android:textColor="@color/secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_medium" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etTanggal"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_soft"
                        android:paddingHorizontal="16dp"
                        android:hint="Pilih Tanggal Rencana"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:inputType="none"
                        android:textColor="#1E293B"
                        android:textColorHint="#94A3B8"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="14sp"
                        android:drawableEnd="@drawable/ic_calendar_month"
                        android:drawableTint="@color/primary"
                        android:layout_marginBottom="18dp" />

                    <!-- 2. LOKASI LAHAN PENGENDALIAN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lokasi Lahan Pengendalian"
                            android:textColor="@color/tertiary"
                            android:textSize="13.5sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*Wajib"
                            android:textColor="@color/secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_medium" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etPilihLahan"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_soft"
                        android:paddingHorizontal="16dp"
                        android:hint="Klik untuk Pilih Lahan"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:inputType="none"
                        android:textColor="#1E293B"
                        android:textColorHint="#94A3B8"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="14sp"
                        android:drawableEnd="@drawable/ic_map_pin"
                        android:drawableTint="@color/primary" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupLahan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleLine="false"
                        app:singleSelection="false" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD CONTAINER 2: RINCIAN KEGIATAN & BAHAN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 3. NAMA KEGIATAN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Nama Kegiatan"
                            android:textColor="@color/tertiary"
                            android:textSize="13.5sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*Wajib"
                            android:textColor="@color/secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_medium" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        app:boxStrokeColor="#E2E8F0"
                        app:boxStrokeWidth="1dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#F8FAFC">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerKegiatan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Pilih Kegiatan (Hama / Gulma / Pemupukan)"
                            android:inputType="none"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#1E293B" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 4. NAMA RACUN / PUPUK -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Nama Racun / Pupuk"
                            android:textColor="@color/tertiary"
                            android:textSize="13.5sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*Wajib"
                            android:textColor="@color/secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_medium" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etNamaBahan"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_soft"
                        android:paddingHorizontal="16dp"
                        android:hint="Contoh: Gramoxone / NPK Phonska / Roundup"
                        android:inputType="textPersonName"
                        android:textColor="#1E293B"
                        android:textColorHint="#94A3B8"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="14sp"
                        android:layout_marginBottom="18dp" />

                    <!-- 5. BARIS JUMLAH & SATUAN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- JUMLAH -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Jumlah"
                                    android:textColor="@color/tertiary"
                                    android:textSize="13.5sp"
                                    android:fontFamily="@font/poppins_semibold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="*Wajib"
                                    android:textColor="@color/secondary"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/poppins_medium" />
                            </LinearLayout>

                            <EditText
                                android:id="@+id/etDosis"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:background="@drawable/bg_input_soft"
                                android:paddingHorizontal="16dp"
                                android:hint="0"
                                android:inputType="numberDecimal"
                                android:textColor="#1E293B"
                                android:textColorHint="#94A3B8"
                                android:fontFamily="@font/poppins_medium"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- SATUAN -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Satuan"
                                android:textColor="@color/tertiary"
                                android:textSize="13.5sp"
                                android:fontFamily="@font/poppins_semibold"
                                android:layout_marginBottom="6dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxStrokeColor="#E2E8F0"
                                app:boxStrokeWidth="1dp"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:boxBackgroundColor="#F8FAFC">

                                <AutoCompleteTextView
                                    android:id="@+id/spinnerSatuan"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Liter"
                                    android:inputType="none"
                                    android:textSize="13.5sp"
                                    android:fontFamily="@font/poppins_medium"
                                    android:textColor="#1E293B" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD CONTAINER 3: PENANGANAN LIMBAH -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 6. JENIS LIMBAH YANG DIHASILKAN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jenis Limbah Dihasilkan"
                            android:textColor="@color/tertiary"
                            android:textSize="13.5sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*Wajib"
                            android:textColor="@color/secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_medium" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        app:boxStrokeColor="#E2E8F0"
                        app:boxStrokeWidth="1dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#F8FAFC">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerJenisLimbah"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Pilih Limbah (Botol 1L/5L/Plastik)"
                            android:inputType="none"
                            android:textSize="13.5sp"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#1E293B" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 7. STATUS LIMBAH -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status Penyerahan Limbah *"
                        android:textColor="@color/tertiary"
                        android:textSize="13.5sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rgStatusLimbah"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbBelumDisetor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Belum Disetor"
                            android:checked="true"
                            android:textColor="#1E293B"
                            android:fontFamily="@font/poppins_medium"
                            android:textSize="13.5sp" />

                        <RadioButton
                            android:id="@+id/rbSudahDisetor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sudah Disetor"
                            android:textColor="#1E293B"
                            android:fontFamily="@font/poppins_medium"
                            android:textSize="13.5sp" />

                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TOMBOL SIMPAN (STYLE AUDIT INTERNAL) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="24dp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/primary"
                android:text="Simpan Data Kegiatan"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                app:icon="@drawable/ic_save"
                app:iconTint="#FFFFFF"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:iconGravity="textStart"
                app:elevation="2dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
