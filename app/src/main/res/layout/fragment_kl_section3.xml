<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card Bukti Kunjungan Lahan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bukti Kunjungan Lahan"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/tertiary"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ivFotoBukti"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="#F1F5F9"
                            android:contentDescription="Foto Bukti" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAmbilFoto"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="10dp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="#FFFFFF"
                        android:text="Ambil Foto Bukti" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Lokasi & Waktu -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Data Lokasi &amp; Waktu"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/tertiary"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/tvWaktu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Waktu: Belum didapatkan"
                        android:textColor="#334155"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="13.5sp"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvLokasi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lokasi: Belum didapatkan"
                        android:textColor="#334155"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="13.5sp"
                        android:layout_marginBottom="14dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetLokasiWaktu"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="10dp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="#FFFFFF"
                        android:text="Dapatkan Lokasi &amp; Waktu" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Keputusan / Status -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Keputusan / Status Kunjungan"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/tertiary"
                        android:layout_marginBottom="10dp"/>

                    <RadioGroup
                        android:id="@+id/rgStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/rbPerluPerbaikan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Perlu Perbaikan"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#1E293B"
                            android:checked="true"/>

                        <RadioButton
                            android:id="@+id/rbSelesai"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lulus"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#1E293B"/>
                    </RadioGroup>

                    <LinearLayout
                        android:id="@+id/layoutTanggalPerbaikan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tanggal Perbaikan Selanjutnya *"
                            android:textSize="13.5sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/tertiary"
                            android:layout_marginBottom="6dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_calendar_month">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTanggalPerbaikan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:clickable="true"
                                android:hint="Pilih tanggal perbaikan"
                                android:fontFamily="@font/poppins_medium"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ringkasan Temuan / Keterangan"
                        android:layout_marginBottom="4dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRingkasanTemuan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:fontFamily="@font/poppins_regular"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Kembali"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/primary"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp"
            app:cornerRadius="12dp"
            app:backgroundTint="#FFFFFF" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpan"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Simpan"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/primary" />

    </LinearLayout>

</LinearLayout>
