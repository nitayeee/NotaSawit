<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bukti Kunjungan Lahan"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/black"
                android:layout_marginBottom="16dp"/>

            <ImageView
                android:id="@+id/ivFotoBukti"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="#E0E0E0"
                android:layout_marginBottom="12dp"
                android:contentDescription="Foto Bukti" />

            <Button
                android:id="@+id/btnAmbilFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/secondary"
                android:text="Ambil Foto"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Lokasi dan Waktu"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvWaktu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waktu: Belum didapatkan"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvLokasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lokasi: Belum didapatkan"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnGetLokasiWaktu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/secondary"
                android:text="Dapatkan Lokasi &amp; Waktu"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            app:backgroundTint="@color/secondary"
            android:text="Kembali"/>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp"/>

        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            app:backgroundTint="@color/secondary"
            android:text="Simpan"/>

    </LinearLayout>

</LinearLayout>
