<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Green glow from top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="0.0"
                android:gradientRadius="60%p"
                android:startColor="#801B4D2E"
                android:endColor="#001B4D2E" />
        </shape>
    </item>
    <!-- Green-yellow mix glow from top-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="0.0"
                android:gradientRadius="60%p"
                android:startColor="#601B4D2E"
                android:endColor="#001B4D2E" />
        </shape>
    </item>
    <!-- Yellow glow from bottom-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="1.0"
                android:gradientRadius="60%p"
                android:startColor="#80D4AF37"
                android:endColor="#00D4AF37" />
        </shape>
    </item>
    <!-- Yellow-green mix glow from bottom-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="1.0"
                android:gradientRadius="60%p"
                android:startColor="#601B4D2E"
                android:endColor="#001B4D2E" />
        </shape>
    </item>
</layer-list>
